{
  "redirects": [
    {
      "source": "/sportpharm-pharmacy-check-in",
      "destination": "/sportpharm-pharmacy-check-in/",
      "permanent": true
    },
    {
      "source": "/checkin",
      "destination": "/checkin/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type"
        }
      ]
    }
  ]
}
